+        private func importDoseDiary(entries: [DoseDiaryEntry]) throws {
+            let parsed = entries.compactMap { entry -> (DoseDiaryEntry, Date, Date)? in
+                guard let takenAt = parseISO8601(entry.takenAt) else { return nil }
+                let createdAt = entry.createdAt.flatMap { parseISO8601($0) } ?? takenAt
+                return (entry, takenAt, createdAt)
+            }.sorted { $0.1 < $1.1 }
+
+            guard parsed.count == entries.count else {
+                throw CocoaError(.fileReadCorruptFile)
+            }
+
+            try PersistenceController.shared.deleteEverything()
+            let context = PersistenceController.shared.viewContext
+            var companionDict: [String: SubstanceCompanion] = [:]
+            var customSubstanceUnits: [String: String] = [:]
+
+            for session in makeDoseDiarySessions(parsed) {
+                guard let first = session.first else { continue }
+                let names = session.map { canonicalSubstanceName($0.0.substance) }.uniqued()
+                let titleNames = Array(names.prefix(3))
+                let extraCount = names.count - titleNames.count
+                let titleSuffix = extraCount > 0 ? " +\(extraCount)" : ""
+
+                let experience = Experience(context: context)
+                experience.title = titleNames.joined(separator: " + ") + titleSuffix
+                experience.text = "Imported from Dose Diary • \(session.count) dose\(session.count == 1 ? "" : "s")"
+                experience.creationDate = first.2
+                experience.sortDate = first.1
+                experience.isFavorite = false
+
+                for (entry, takenAt, createdAt) in session {
+                    let name = canonicalSubstanceName(entry.substance)
+                    let ingestion = Ingestion(context: context)
+                    ingestion.substanceName = name
+                    ingestion.time = takenAt
+                    ingestion.creationDate = createdAt
+                    ingestion.administrationRoute = canonicalRoute(entry.route).rawValue
+                    ingestion.dose = entry.amount
+                    ingestion.estimatedDoseStandardDeviation = 0
+                    ingestion.isEstimate = false
+                    ingestion.units = canonicalUnit(entry.unit)
+                    ingestion.note = entry.notes
+                    experience.addToIngestions(ingestion)
+
+                    if let companion = companionDict[name] {
+                        ingestion.substanceCompanion = companion
+                    } else {
+                        let companion = SubstanceCompanion(context: context)
+                        companion.substanceName = name
+                        companion.colorAsText = color(for: name).rawValue
+                        companionDict[name] = companion
+                        ingestion.substanceCompanion = companion
+                    }
+
+                    if SubstanceRepo.shared.getSubstance(name: name) == nil {
+                        customSubstanceUnits[name] = canonicalUnit(entry.unit)
+                    }
+                }
+            }
+
+            for (name, units) in customSubstanceUnits.sorted(by: { $0.key < $1.key }) {
+                let custom = CustomSubstance(context: context)
+                custom.name = name
+                custom.units = units
+                custom.explanation = "Imported from a Dose Diary backup."
+            }
+
+            try context.save()
+        }
+
+        private func makeDoseDiarySessions(
+            _ entries: [(DoseDiaryEntry, Date, Date)]
+        ) -> [[(DoseDiaryEntry, Date, Date)]] {
+            let sessionGap: TimeInterval = 12 * 60 * 60
+            var sessions: [[(DoseDiaryEntry, Date, Date)]] = []
+            for entry in entries {
+                if let previous = sessions.last?.last, entry.1.timeIntervalSince(previous.1) <= sessionGap {
+                    sessions[sessions.count - 1].append(entry)
+                } else {
+                    sessions.append([entry])
+                }
+            }
+            return sessions
+        }
+
+        private func parseISO8601(_ value: String) -> Date? {
+            let formatter = ISO8601DateFormatter()
+            formatter.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+            if let date = formatter.date(from: value) { return date }
+            formatter.formatOptions = [.withInternetDateTime]
+            return formatter.date(from: value)
+        }
+
+        private func canonicalSubstanceName(_ rawName: String) -> String {
+            let trimmed = rawName.trimmingCharacters(in: .whitespacesAndNewlines)
+            let aliases: [String: String] = [
+                "lisdexphetamine": "Lisdexamfetamine",
+                "lisdexamphetamine": "Lisdexamfetamine",
+                "vyvanse": "Lisdexamfetamine",
+                "mushrooms": "Psilocybin mushrooms",
+                "4fluoromethylphenidate": "4F-MPH",
+                "pseudoephrine": "Pseudoephedrine",
+                "3ohphenazepam": "3-HO-Phenazepam"
+            ]
+            let key = searchableKey(trimmed)
+            if let alias = aliases[key] { return alias }
+
+            for substance in SubstanceRepo.shared.substances {
+                if searchableKey(substance.name) == key
+                    || substance.commonNames.contains(where: { searchableKey($0) == key }) {
+                    return substance.name
+                }
+            }
+            return trimmed
+        }
+
+        private func searchableKey(_ value: String) -> String {
+            value.lowercased().unicodeScalars
+                .filter(CharacterSet.alphanumerics.contains)
+                .map(String.init)
+                .joined()
+        }
+
+        private func canonicalRoute(_ rawRoute: String) -> AdministrationRoute {
+            let key = rawRoute.lowercased().trimmingCharacters(in: .whitespacesAndNewlines)
+            let aliases: [String: AdministrationRoute] = [
+                "swallowed": .oral,
+                "snorted": .insufflated,
+                "intranasal": .insufflated,
+                "vaporized": .inhaled,
+                "vaped": .inhaled
+            ]
+            return AdministrationRoute(rawValue: key) ?? aliases[key] ?? .oral
+        }
+
+        private func canonicalUnit(_ rawUnit: String) -> String {
+            switch rawUnit.lowercased().trimmingCharacters(in: .whitespacesAndNewlines) {
+            case "mcg", "ug", "μg", "µg": return "µg"
+            case "ml": return "mL"
+            default: return rawUnit.trimmingCharacters(in: .whitespacesAndNewlines)
+            }
+        }
+
+        private func color(for substanceName: String) -> SubstanceColor {
